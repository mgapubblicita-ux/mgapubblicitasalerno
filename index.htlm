<!DOCTYPE html>
<html lang="it" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>M.G.A. Pubblicità | Cartelloni 6x3 e Camion Vela a Salerno</title>
    <meta name="description" content="Pubblicità esterna a Salerno: postazioni strategiche 6x3 in Zona ASI, Via San Leonardo, Ospedale Ruggi e servizio Camion Vela itinerante.">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Montserrat per i titoli, Inter per i testi -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Configurazione Tailwind personalizzata -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#0F172A',
                            slate: '#1E293B',
                            accent: '#F97316',
                            accentHover: '#EA580C',
                            light: '#F8FAFC'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        .hero-pattern {
            background-color: #0F172A;
            background-image: radial-gradient(rgba(249, 115, 22, 0.14) 1px, transparent 1px);
            background-size: 28px 28px;
        }
        .card-hover {
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(15, 23, 42, 0.1), 0 8px 10px -6px rgba(15, 23, 42, 0.06);
        }
    </style>
</head>
<body class="bg-brand-light text-slate-800 antialiased selection:bg-brand-accent selection:text-white">

    <!-- ==================== HEADER ==================== -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo testuale -->
                <a href="#" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 rounded-xl bg-brand-dark flex items-center justify-center text-brand-accent font-heading font-extrabold text-xl shadow-md group-hover:bg-brand-accent group-hover:text-white transition-colors">
                        M
                    </div>
                    <div>
                        <span class="font-heading font-extrabold text-lg sm:text-xl tracking-tight text-brand-dark block leading-none">
                            M.G.A. PUBBLICITÀ
                        </span>
                        <span class="text-xs font-medium text-slate-500 tracking-wide">
                            Salerno • Esterna &amp; Camion Vela
                        </span>
                    </div>
                </a>

                <!-- Navigazione Desktop -->
                <nav class="hidden md:flex items-center gap-8">
                    <a href="#postazioni" class="text-sm font-medium text-slate-600 hover:text-brand-accent transition-colors">Postazioni 6x3</a>
                    <a href="#camion-vela" class="text-sm font-medium text-slate-600 hover:text-brand-accent transition-colors">Camion Vela</a>
                    <a href="#perche-noi" class="text-sm font-medium text-slate-600 hover:text-brand-accent transition-colors">Perché sceglierci</a>
                    <a href="#contatti" class="px-4 py-2.5 rounded-lg bg-brand-accent text-white text-sm font-semibold hover:bg-brand-accentHover transition-colors shadow-sm">
                        Contatti
                    </a>
                </nav>

                <!-- Bottone menu mobile -->
                <button id="menu-btn" type="button" class="md:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100" aria-label="Apri menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Menu Mobile -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-200 px-4 py-4 space-y-3">
            <a href="#postazioni" class="block py-2 text-sm font-medium text-slate-700 hover:text-brand-accent">Postazioni 6x3</a>
            <a href="#camion-vela" class="block py-2 text-sm font-medium text-slate-700 hover:text-brand-accent">Camion Vela</a>
            <a href="#perche-noi" class="block py-2 text-sm font-medium text-slate-700 hover:text-brand-accent">Perché sceglierci</a>
            <a href="#contatti" class="block py-2.5 px-4 rounded-lg bg-brand-accent text-white text-center text-sm font-semibold">Contatti</a>
        </div>
    </header>

    <!-- ==================== HERO ==================== -->
    <section class="hero-pattern text-white py-20 sm:py-28">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="inline-block px-4 py-1.5 rounded-full bg-brand-accent/15 border border-brand-accent/40 text-brand-accent text-xs font-semibold uppercase tracking-wider mb-6">
                Pubblicità Esterna a Salerno
            </span>
            <h1 class="font-heading font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight max-w-4xl mx-auto">
                Fai vedere la tua azienda dove passa <span class="text-brand-accent">Salerno ogni giorno</span>
            </h1>
            <p class="mt-6 text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
                Impianti pubblicitari <strong class="text-white">6x3 metri</strong> nei punti ad alta viabilità e servizio <strong class="text-white">Camion Vela itinerante</strong> per campagne mirate su città, quartieri e grande distribuzione.
            </p>
            <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#contatti" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-brand-accent hover:bg-brand-accentHover text-white font-semibold text-sm sm:text-base transition-colors shadow-lg">
                    Richiedi disponibilità e preventivo
                </a>
                <a href="#postazioni" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm sm:text-base border border-white/15 transition-colors">
                    Scopri le postazioni 6x3
                </a>
            </div>
        </div>
    </section>

    <!-- ==================== POSTAZIONI 6x3 ==================== -->
    <section id="postazioni" class="py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl mx-auto text-center mb-14">
                <span class="text-brand-accent font-semibold text-xs uppercase tracking-wider">Impianti fissi</span>
                <h2 class="font-heading font-bold text-2xl sm:text-4xl text-brand-dark mt-2">
                    Postazioni strategiche 6x3 a Salerno
                </h2>
                <p class="mt-3 text-slate-600 text-sm sm:text-base">
                    Grandi formati ad alta visibilità posizionati su assi di scorrimento e aree ad elevato traffico veicolare e pedonale.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Zona ASI -->
                <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm card-hover">
                    <div class="w-11 h-11 rounded-xl bg-brand-accent/10 text-brand-accent flex items-center justify-center font-heading font-bold text-lg mb-5">
                        01
                    </div>
                    <h3 class="font-heading font-bold text-xl text-brand-dark">Zona ASI Salerno</h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Ideale per raggiungere aziende, fornitori, lavoratori e automobilisti lungo il principale polo produttivo e commerciale.
                    </p>
                </div>

                <!-- Via San Leonardo -->
                <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm card-hover">
                    <div class="w-11 h-11 rounded-xl bg-brand-accent/10 text-brand-accent flex items-center justify-center font-heading font-bold text-lg mb-5">
                        02
                    </div>
                    <h3 class="font-heading font-bold text-xl text-brand-dark">Via San Leonardo</h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Snodo chiave tra la zona orientale e il resto della città, caratterizzato da flusso costante quotidiano in entrambe le direzioni.
                    </p>
                </div>

                <!-- Ospedale Ruggi -->
                <div class="bg-white rounded-2xl p-7 border border-slate-200/80 shadow-sm card-hover">
                    <div class="w-11 h-11 rounded-xl bg-brand-accent/10 text-brand-accent flex items-center justify-center font-heading font-bold text-lg mb-5">
                        03
                    </div>
                    <h3 class="font-heading font-bold text-xl text-brand-dark">Area Ospedale Ruggi</h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                        Presenza ad altissimo passaggio continuo di utenti, personale, visitatori e mezzi provenienti da tutta la provincia.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== CAMION VELA ==================== -->
    <section id="camion-vela" class="py-20 bg-brand-dark text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <span class="text-brand-accent font-semibold text-xs uppercase tracking-wider">Pubblicità dinamica</span>
                    <h2 class="font-heading font-bold text-2xl sm:text-4xl mt-2 leading-tight">
                        Servizio Camion Vela itinerante
                    </h2>
                    <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
                        Porta il tuo messaggio esattamente dove serve, nel momento giusto: aperture punti vendita, promozioni, eventi, campagne locali e comunicazione per la grande distribuzione.
                    </p>
                    <ul class="mt-6 space-y-3 text-sm text-slate-200">
                        <li class="flex items-start gap-2.5">
                            <span class="text-brand-accent font-bold">✓</span>
                            <span>Percorsi personalizzabili a Salerno e nei comuni limitrofi.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-brand-accent font-bold">✓</span>
                            <span>Grande superficie espositiva bifacciale visibile a distanza.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="text-brand-accent font-bold">✓</span>
                            <span>Flessibilità per campagne stagionali, lancio offerte o eventi.</span>
                        </li>
                    </ul>
                </div>

                <div class="bg-brand-slate rounded-2xl p-8 border border-white/10">
                    <h3 class="font-heading font-bold text-lg text-white mb-4">Quando scegliere il Camion Vela</h3>
                    <div class="space-y-4 text-sm text-slate-300">
                        <div class="p-4 rounded-xl bg-white/5">
                            <p class="font-semibold text-white">Promozioni &amp; Grande Distribuzione</p>
                            <p class="mt-1 text-slate-400">Presidio mirato nei quartieri e nelle strade di accesso ai punti vendita.</p>
                        </div>
                        <div class="p-4 rounded-xl bg-white/5">
                            <p class="font-semibold text-white">Inaugurazioni &amp; Eventi Locali</p>
                            <p class="mt-1 text-slate-400">Massima visibilità concentrata nei giorni chiave della campagna.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== PERCHÉ SCEGLIERCI ==================== -->
    <section id="perche-noi" class="py-20 sm:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-2xl mx-auto text-center mb-14">
                <span class="text-brand-accent font-semibold text-xs uppercase tracking-wider">Il nostro approccio</span>
                <h2 class="font-heading font-bold text-2xl sm:text-4xl text-brand-dark mt-2">
                    Perché scegliere M.G.A. Pubblicità
                </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                    <h3 class="font-heading font-bold text-base text-brand-dark">Conoscenza del territorio</h3>
                    <p class="mt-2 text-sm text-slate-600">Selezioniamo posizionamenti concreti in base ai flussi reali di Salerno.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                    <h3 class="font-heading font-bold text-base text-brand-dark">Contatto diretto</h3>
                    <p class="mt-2 text-sm text-slate-600">Parli senza intermediari inutili, con risposte chiare e tempi rapidi.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                    <h3 class="font-heading font-bold text-base text-brand-dark">Soluzioni su misura</h3>
                    <p class="mt-2 text-sm text-slate-600">Dalla piccola attività locale alle campagne strutturate per catene e retail.</p>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                    <h3 class="font-heading font-bold text-base text-brand-dark">Impatto visivo</h3>
                    <p class="mt-2 text-sm text-slate-600">Formati grandi e presenza costante nella quotidianità di chi si muove in città.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== CONTATTI ==================== -->
    <section id="contatti" class="py-20 bg-white border-t border-slate-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="text-brand-accent font-semibold text-xs uppercase tracking-wider">Parliamo della tua campagna</span>
            <h2 class="font-heading font-bold text-2xl sm:text-4xl text-brand-dark mt-2">
                Contatta M.G.A. Pubblicità
            </h2>
            <p class="mt-3 text-slate-600 text-sm sm:text-base max-w-xl mx-auto">
                Vuoi verificare la disponibilità delle postazioni 6x3 o pianificare un giro con il Camion Vela a Salerno? Chiamaci o scrivici.
            </p>

            <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6 text-left">
                <div class="p-6 rounded-2xl bg-brand-light border border-slate-200">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Area Operativa</p>
                    <p class="mt-1.5 font-heading font-bold text-brand-dark">Salerno e Provincia</p>
                </div>
                <div class="p-6 rounded-2xl bg-brand-light border border-slate-200">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Telefono</p>
                    <div class="mt-1.5 space-y-1">
                        <a href="tel:33406431005" class="block font-heading font-bold text-brand-dark hover:text-brand-accent transition-colors">
                            33406431005
                        </a>
                        <a href="tel:3784087184" class="block font-heading font-bold text-brand-dark hover:text-brand-accent transition-colors">
                            3784087184
                        </a>
                    </div>
                </div>
                <div class="p-6 rounded-2xl bg-brand-light border border-slate-200">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Email</p>
                    <a href="mailto:m.g.a.pubblicita@gmail.com" class="mt-1.5 block font-heading font-bold text-brand-dark hover:text-brand-accent transition-colors break-all">
                        m.g.a.pubblicita@gmail.com
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ==================== FOOTER ==================== -->
    <footer class="bg-brand-dark text-slate-400 py-8 text-center text-xs sm:text-sm">
        <div class="max-w-7xl mx-auto px-4">
            © <span id="anno"></span> M.G.A. Pubblicità — Cartelloni 6x3 e Camion Vela a Salerno. Tutti i diritti riservati.
        </div>
    </footer>

    <script>
        document.getElementById('anno').textContent = new Date().getFullYear();
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }
    </script>
</body>
</html>
